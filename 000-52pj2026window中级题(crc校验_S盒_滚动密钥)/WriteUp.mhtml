@charset "gbk";

* { overflow-wrap: break-word; }

body { background: url("https://static.52pojie.cn/static/image/common/backg=
round.png") 0px 0px repeat-x rgb(255, 255, 255); }

body, input, button, select, textarea { font: 13px / 1.5 -apple-system, Bli=
nkMacSystemFont, "Segoe UI", Tahoma, "PingFang SC", "Hiragino Sans GB", "Mi=
crosoft Yahei", Simsun, sans-serif; color: rgb(68, 68, 68); }

